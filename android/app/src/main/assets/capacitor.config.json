{
	"appId": "com.qgo.app",
	"appName": "QGo",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"hostname": "qgo.app"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"backgroundColor": "#E73229",
			"launchAutoHide": true,
			"showSpinner": false
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com",
				"phone"
			]
		},
		"CapacitorHttp": {
			"enabled": true
		}
	}
}
