# Port number for the Express server (default: 3000)
PORT="3000"

# Application environment mode ('development' or 'production')
NODE_ENV="development"

# Canonical URL of the QGo app web domain (e.g. https://qgo.app)
APP_URL=""

# Frontend origin URL for web clients
FRONTEND_URL=""

# Backend API base URL for Capacitor native app (empty for web same-origin)
VITE_API_URL=""

# Comma-separated list of allowed CORS origins for API requests
QGO_ALLOWED_ORIGINS="https://qgo.app,capacitor://localhost,http://localhost,http://localhost:3000,https://localhost"

# Google OAuth 2.0 Web Client ID for client-side sign-in
VITE_GOOGLE_CLIENT_ID=""

# Google OAuth Client ID for server-side verification
GOOGLE_CLIENT_ID=""

# Comma-separated list of authorized Google OAuth Client IDs (Android, iOS, Web)
GOOGLE_CLIENT_IDS=""

# Firebase Client Web API Key (publicly safe identifier for Firebase Auth/Firestore)
VITE_FIREBASE_API_KEY=""

# Firebase Auth domain (e.g. project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=""

# Firebase Project ID for web client SDK
VITE_FIREBASE_PROJECT_ID=""

# Firebase Storage Bucket URL (e.g. project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=""

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Firebase Web Application ID
VITE_FIREBASE_APP_ID=""

# Firebase Google Analytics Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=""

# Firebase Project ID for server Admin SDK
FIREBASE_PROJECT_ID=""

# Firebase Storage Bucket for server Admin SDK
FIREBASE_STORAGE_BUCKET=""

# Set to 'true' when using Google Cloud Application Default Credentials on GCP
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=""

# Absolute filesystem path to Firebase Admin service account JSON credentials
GOOGLE_APPLICATION_CREDENTIALS=""

# Raw or base64-encoded Firebase service account JSON string (alternative to file path)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Local Firestore emulator host for automated testing (e.g. localhost:8080)
FIRESTORE_EMULATOR_HOST=""

# Local Firebase Auth emulator host for automated testing (e.g. localhost:9099)
FIREBASE_AUTH_EMULATOR_HOST=""

# Cryptographic session secret used for signing QR codes and tokens (min 32 characters, required)
QGO_SESSION_SECRET=""

# Comma-separated administrator email addresses granted platform admin privileges
QGO_ADMIN_EMAILS=""
